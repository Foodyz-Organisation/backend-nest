# Backend NestJS Environment Variables

# MongoDB
MONGO_URI=mongodb://localhost:27017/Foodyz

# JWT Secret
JWT_SECRET=supersecretkey

# Spam Detection Service (FastAPI)
SPAM_API_URL=http://localhost:8000

# Gemini AI API Keys (separate keys for different features)
# For reclamation/points validation system
GEMINI_API_KEY=your_gemini_api_key_for_reclamation_here

# For menu item suggestions feature
GEMINI_API_KEY_MENU_SUGGESTIONS=your_gemini_api_key_for_menu_suggestions_here

# Server Port
PORT=3000
